{
  "name": "@savetowin/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/db && cp -R db/migrations dist/db/migrations",
    "start": "node dist/src/index.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@savetowin/shared": "^0.0.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.2",
    "typescript": "^7.0.2"
  }
}
