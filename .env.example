# Copiar a `.env` y ajustar. No commitear `.env`.

# Dev local (Postgres del compose en el host):
DATABASE_URL=postgres://savetowin:savetowin@localhost:5433/savetowin
PORT=3010

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Registro abierto por defecto. Cerrar: REGISTRATION_OPEN=false
REGISTRATION_OPEN=true

# Correo (códigos para cambiar email/contraseña). Cualquier SMTP: Gmail con
# contraseña de aplicación, Brevo, el de tu dominio… Sin SMTP_HOST: en dev se
# imprime en consola; en prod esos cambios quedan desactivados.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicación
# MAIL_FROM="saveToWin <tu-cuenta@gmail.com>"

# Compose (servicio app). En prod usa un secreto largo.
# APP_PORT=3010
# HTTPS: docker compose --profile https up -d
