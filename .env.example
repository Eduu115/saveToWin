# Copiar a `.env` y ajustar. No commitear `.env`.

# Dev local (Postgres del compose en el host):
DATABASE_URL=postgres://savetowin:savetowin@localhost:5433/savetowin
PORT=3010

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Registro abierto por defecto. Cerrar: REGISTRATION_OPEN=false
REGISTRATION_OPEN=true

# Detrás de un proxy, de qué cabecera sale la IP real (límite de intentos de login):
#   cloudflare → CF-Connecting-IP (Cloudflare Tunnel o proxy de Cloudflare)
#   proxy      → última entrada de X-Forwarded-For (Caddy, nginx…)
# Sin definir: la IP de la conexión. No lo actives sin proxy delante: las cabeceras
# se pueden inventar.
# TRUSTED_PROXY=cloudflare

# Correo (códigos para cambiar email/contraseña). Cualquier SMTP: Gmail con
# contraseña de aplicación, Brevo, el de tu dominio… Sin SMTP_HOST: en dev se
# imprime en consola; en prod esos cambios quedan desactivados.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicación
# MAIL_FROM="saveToWin <tu-cuenta@gmail.com>"

# Compose (servicio app). En prod usa un secreto largo.
# TZ=Europe/Madrid
# APP_PORT=3010
# HTTPS: docker compose --profile https up -d

# ops/ (opcional). Copia cifrada fuera del servidor (Backblaze B2 + restic):
# B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
# B2_BUCKET=
# B2_KEY_ID=
# B2_APP_KEY=
# RESTIC_PASSWORD=          # guárdala también fuera del servidor
# Avisos (healthchecks.io):
# HC_BACKUP_URL=https://hc-ping.com/…
# HC_DEPLOY_URL=https://hc-ping.com/…
# HC_UP_URL=https://hc-ping.com/…
# HEALTH_URL=https://tu-dominio/api/health
